# Copy this file to `.env` and fill in your deployed Data Client Worker URL.
# Vite exposes VITE_* to the extension at build time (import.meta.env.VITE_WORKER_BASE).
# Loaded automatically by both `npm run dev` and `npm run build` — no inline env needed.
VITE_WORKER_BASE=https://<your-worker-host>.workers.dev
