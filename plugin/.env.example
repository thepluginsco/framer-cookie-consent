# Consentful plugin — optional environment variables.
# Copy to `.env.local` and fill in only what you want. Everything here is
# OPTIONAL; with nothing set the plugin builds and runs exactly the same.

# Optional error reporting for the plugin editor UI (Sentry free tier).
# Leave unset to keep error reporting OFF (default, zero cost, no network).
#
# To enable:
#   1. Create a free Sentry project and copy its DSN.
#   2. Add Sentry's "Loader Script" <script> to plugin/index.html so window.Sentry
#      exists (no npm install required), OR bundle @sentry/browser (see
#      src/lib/errorReporting.ts for the bundled-SDK variant).
#   3. Uncomment and set the DSN below.
#
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ---------------------------------------------------------------------------
# Lemon Squeezy licensing ids (REQUIRED to sell Pro; see src/lib/licenseConfig.ts).
# Until VITE_LS_STORE_ID is a real (non-zero) id, every entered key stays on the
# free trial — the validation code is ready, it just has nothing to match against.
# Find these in the Lemon Squeezy dashboard:
#   • store id  → Settings → Stores (numeric id)
#   • product   → Products → your product → numeric id in the URL
#   • variant   → Products → your product → Variants → numeric id
#   • URL       → the public checkout/product page a buyer lands on
# ---------------------------------------------------------------------------
# VITE_LS_STORE_ID=12345
# VITE_LS_PRODUCT_URL=https://your-store.lemonsqueezy.com/buy/xxxxxxxx
#
# VITE_LS_LIFETIME_PRODUCT_ID=0
# VITE_LS_LIFETIME_VARIANT_ID=0
# VITE_LS_PRO_PRODUCT_ID=0
# VITE_LS_PRO_VARIANT_ID=0
# VITE_LS_AGENCY_PRODUCT_ID=0
# VITE_LS_AGENCY_VARIANT_ID=0
