# Dependencies
node_modules/
.npm/

# Build output
dist/
build/
*.tsbuildinfo

# EXCEPTION: the runtime bundle is a PUBLISHED artifact — jsDelivr serves it
# straight from the committed git tag, so it must be tracked despite `dist/`.
!runtime/dist/
runtime/dist/*
!runtime/dist/consent.min.js

# Environment & secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*

# Test / coverage
coverage/
