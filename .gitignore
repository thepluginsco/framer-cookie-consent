# Dependencies
node_modules/
.npm/

# Build output
dist/
build/
*.tsbuildinfo

# EXCEPTION: the runtime bundle is a PUBLISHED artifact — jsDelivr serves it
# straight from the committed git tag, so it must be tracked despite `dist/`.
!runtime/dist/
runtime/dist/*
!runtime/dist/consent.min.js
# Built-in language packs, fetched by the runtime from the same tag.
!runtime/dist/locales/

# Environment & secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*

# Test / coverage
coverage/

# Shopify CLI project cache
.shopify/

# Large marketing media: kept locally, not in the repo (jsDelivr serves tags
# from a full repo download and refuses packages over 50 MB).
marketing/store-assets/
brag-output/
